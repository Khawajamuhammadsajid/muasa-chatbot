# Shopify App Credentials (automatically populated by shopify app dev)
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-domain.com

# Server-Side Gemini API Key (Required for AI assistant responses)
# Never exposed to client or merchant UI
GEMINI_API_KEY=your_google_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash

# Required Access Scopes
SCOPES=read_products,read_inventory,write_draft_orders,read_draft_orders,write_orders,read_orders

# App Server Port & Environment
PORT=3000
NODE_ENV=production
